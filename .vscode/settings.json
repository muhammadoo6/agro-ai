{
  "dart.lineLength": 100,
  "editor.formatOnSave": true,
  "[dart]": {
    "editor.rulers": [100],
    "editor.tabSize": 2
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "files.exclude": {
    "**/build": true,
    "**/.dart_tool": true
  },
  "files.encoding": "utf8"
}
